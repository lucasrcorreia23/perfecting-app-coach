{
  "expo": {
    "name": "Perfecting Field",
    "slug": "perfecting-field",
    "scheme": "perfectingfield",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1F1F1F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.perfecting.field",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Usamos o microfone para gravar suas conversas de venda e gerar feedback de coaching."
      }
    },
    "android": {
      "package": "br.com.perfecting.field",
      "adaptiveIcon": {
        "backgroundColor": "#1F1F1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Usamos o microfone para gravar suas conversas de venda e gerar feedback de coaching."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F1F1F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
